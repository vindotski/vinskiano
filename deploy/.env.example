# Copy to /opt/vinskiano/.env on the server. The deploy workflow only changes
# VINSKIANO_TAG; everything else is yours.

# Public hostname. DNS A/AAAA records for it and for www.<it> must point at the server.
VINSKIANO_DOMAIN=vinskiano.app

# Image tag to run: a release (1.0.0) or an immutable sha-abc1234 to pin or roll back.
VINSKIANO_TAG=1.0.0

# Container resources (defaults shown): memory and CPUs for the app, and Node's heap.
# APP_MEMORY=384m
# APP_CPUS=1
# APP_NODE_HEAP_MB=192
