# The server's settings. Locally, `pnpm exec spotcraft dev` starts Spotcraft's local stack
# (Postgres and the user pool), applies the migrations and writes all of these to .env.
# On Spotcraft, the server sets them; the app's env needs nothing.

# The app's schema, as its own role (the local stack listens on 127.0.0.1).
DATABASE_URL=
DATABASE_SCHEMA=app_vinskiano
# The app's address: https, or http on localhost.
PUBLIC_URL=http://localhost:3000
# Spotcraft's user pool: where it answers, the `iss` of its tokens, and its public keys.
AUTH_URL=
AUTH_ISSUER=
AUTH_JWKS_URL=

# Docker Compose only: the local stack's network, `<stack>_default`, with the stack's name from
# `pnpm exec spotcraft dev status`. Needed when it isn't spotcraft-dev-vinskiano_default.
# SPOTCRAFT_DEV_NETWORK=
