# The server's settings. Locally, `pnpm exec spotcraft dev start` runs Postgres and
# `pnpm exec spotcraft dev env --write` adds DATABASE_URL and AUTH_SECRET to .env;
# copy PUBLIC_URL from here. On Spotcraft, DATABASE_URL comes from the dashboard
# (Database), and AUTH_SECRET is a new `openssl rand -hex 32`, never the local one.

# Postgres for this app (the local stack listens on 127.0.0.1:54340).
DATABASE_URL=
# Signs the guests' session cookies; 32+ characters. Changing it signs every guest out.
AUTH_SECRET=
# The app's address: https, or http on localhost.
PUBLIC_URL=http://localhost:3000
