  "author": "Ivan Vinski <ivan@vin.ski> (https://www.vin.ski)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vindotski/vinskiano.git"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "check": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm test:e2e",
    "docker": "docker compose up --build app",
    "docker:dev": "docker compose up --build dev",
    "docker:test": "docker compose run --rm --build test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "nitro": "3.0.261103-rc",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-stately": "^3.51.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "~1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/intent": "0.5.6",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
